{
  // Format with Ruff on save, as the pre-commit hooks do. Zed runs the Ruff from the
  // Pixi environment and also sorts imports (Ruff's organize-imports) when formatting.
  "languages": {
    "Python": {
      "format_on_save": "on",
      // Use only ty (types, navigation) and Ruff. No "...": it would re-enable basedpyright,
      // pyrefly, pyright and pylsp, because this list replaces the default one
      "language_servers": ["ty", "ruff"]
    }
  }
}
